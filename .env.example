# ==============================================================================
# GAYATHRI COMMUNICATION E-COMMERCE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local or .env for local development.
# Replace with your actual Supabase project URL and anon public key.

# Supabase Project Connection Details (Client Safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy alias:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# IMPORTANT SECURITY GUIDANCE:
# 1. Never put the Supabase service_role key, database password, or secret tokens
#    in this file or any file with a VITE_ prefix.
# 2. VITE_ variables are bundled into the public browser JavaScript files.
# 3. Only the public publishable / anon key (protected by Row Level Security) may be exposed here.
