# ==============================================================================
# GAYATHRI COMMUNICATION - DISPOSABLE TEST DATABASE CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.test.local (this file is already in .gitignore).
# 2. Supply the connection string and details for a DISPOSABLE Supabase project
#    or temporary local PostgreSQL instance.
# 3. SAFETY NOTICE: Never provide the production project reference (hmlrjihcselneceaverv).
#    The test runner will automatically abort if production credentials are detected.
# ==============================================================================

# PostgreSQL direct connection string (required for migrations and full DDL/DML assertions)
# From Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
TEST_DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[DISPOSABLE-PROJECT-REF].supabase.co:5432/postgres

# Disposable Supabase project URL (e.g., https://xyzcompanytest.supabase.co)
TEST_SUPABASE_URL=https://[DISPOSABLE-PROJECT-REF].supabase.co

# Optional: Service Role key for authenticated admin RPC testing
TEST_SUPABASE_SERVICE_ROLE_KEY=your-disposable-service-role-key
